# MongoDB Atlas M0 connection string (Database Access user + Network Access allowlist required)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=negotiator

# Used in later phases
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=
ELEVENLABS_WEBHOOK_SECRET=
ELEVENLABS_PHONE_NUMBER_ID=

# Tests default to a local MongoDB; set this to run them against another one.
# TEST_MONGODB_URI=mongodb://localhost:27017
JWT_SECRET=change-me

# Frontend origins allowed by CORS (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
